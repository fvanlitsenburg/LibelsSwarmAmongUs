# PostgreSQL container
POSTGRES_USER=lsau
POSTGRES_PASSWORD=lsau_dev_password
POSTGRES_DB=lsau

# Application database connections
LSAU_DATABASE_URL=postgresql+psycopg://lsau:lsau_dev_password@localhost:5432/lsau
LSAU_TEST_DATABASE_URL=postgresql+psycopg://lsau:lsau_dev_password@localhost:5432/lsau_test

# Source directories
LSAU_DUPO_ROOT=
LSAU_TCP_METADATA=
LSAU_TCP_TEXT_ROOT=

# OCR configuration
LSAU_OCR_BACKEND=
LSAU_OCR_API_KEY=

# LLM configuration
LSAU_LLM_BASE_URL=
LSAU_LLM_API_KEY=
LSAU_LLM_MODEL=

# Transkribus processing API
LSAU_TRANSKRIBUS_API_BASE_URL=https://transkribus.eu/processing/v1
LSAU_TRANSKRIBUS_TOKEN_URL=https://account.readcoop.eu/auth/realms/readcoop/protocol/openid-connect/token
LSAU_TRANSKRIBUS_CLIENT_ID=processing-api-client
# Put your numeric model ID here
LSAU_TRANSKRIBUS_MODEL_ID=

# Your Transkribus credentials
LSAU_TRANSKRIBUS_USERNAME=
LSAU_TRANSKRIBUS_PASSWORD=

# Processing behavior
LSAU_TRANSKRIBUS_POLL_INTERVAL_SECONDS=3
LSAU_TRANSKRIBUS_TIMEOUT_SECONDS=300

# PDF page rendering
LSAU_PDF_RENDER_DPI=300
LSAU_PDF_JPEG_QUALITY=90