# PostgreSQL container
POSTGRES_USER=lsau
POSTGRES_PASSWORD=lsau_dev_password
POSTGRES_DB=lsau

# Application database connections
LSAU_DATABASE_URL=postgresql+psycopg://lsau:lsau_dev_password@localhost:5432/lsau
LSAU_TEST_DATABASE_URL=postgresql+psycopg://lsau:lsau_dev_password@localhost:5432/lsau_test

# Source directories
LSAU_DUPO_ROOT=
LSAU_TCP_METADATA=
LSAU_TCP_TEXT_ROOT=

# OCR configuration
LSAU_OCR_BACKEND=
LSAU_OCR_API_KEY=

# LLM configuration
LSAU_LLM_BASE_URL=
LSAU_LLM_API_KEY=
LSAU_LLM_MODEL=

# choice for OCR
LSAU_OCR_PROVIDER=mistral

# OPENAI
LSAU_OPENAI_API_KEY=

# OpenAI image transcription
LSAU_OPENAI_OCR_MODEL=gpt-5.5
LSAU_OPENAI_OCR_MAX_OUTPUT_TOKENS=12000
LSAU_OPENAI_TIMEOUT_SECONDS=300

# OPENAI agent
LSAU_OPENAI_RELEVANCE_MODEL=gpt-5-nano
LSAU_OPENAI_RELEVANCE_MAX_OUTPUT_TOKENS=800

LSAU_OPENAI_FINAL_MODEL=gpt-5-mini
LSAU_OPENAI_FINAL_MAX_OUTPUT_TOKENS=4000
LSAU_OPENAI_FINAL_REASONING_EFFORT=low

LSAU_FINAL_ASSESSMENT_MAX_ESTIMATED_INPUT_TOKENS=100000

LSAU_ANTHROPIC_API_KEY=

LSAU_ANTHROPIC_RELEVANCE_MODEL=claude-haiku-4-5
LSAU_ANTHROPIC_RELEVANCE_MAX_OUTPUT_TOKENS=2000
LSAU_ANTHROPIC_FINAL_MODEL=claude-sonnet-5

LSAU_ANTHROPIC_FINAL_MAX_OUTPUT_TOKENS=4000
LSAU_ANTHROPIC_FINAL_EFFORT=low
LSAU_ANTHROPIC_TIMEOUT_SECONDS=300


# Mistral image transcription

LSAU_MISTRAL_API_KEY=
LSAU_MISTRAL_API_BASE_URL=https://api.mistral.ai/v1
LSAU_MISTRAL_OCR_MODEL=mistral-ocr-4-0
LSAU_MISTRAL_TIMEOUT_SECONDS=180

# PDF page rendering
LSAU_PDF_RENDER_DPI=300
LSAU_PDF_JPEG_QUALITY=95

# LSAU relevance
LSAU_RELEVANCE_BATCH_SIZE=3
LSAU_RELEVANCE_STOP_CONFIDENCE_THRESHOLD=0.80
LSAU_RELEVANCE_CRITERIA_PATH=relevance_criteria.txt